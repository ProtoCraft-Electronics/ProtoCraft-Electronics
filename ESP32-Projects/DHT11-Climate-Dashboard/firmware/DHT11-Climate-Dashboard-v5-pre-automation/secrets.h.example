// Copy this file to secrets.h in the same folder.
//
// WiFi credentials are NOT set here anymore - they're entered through the
// captive portal on first boot and stored in the ESP32's NVS. See the
// project README for how that works.
//
// GOOGLE_SCRIPT_URL is only needed if you want cloud logging to a Google
// Sheet. Leave it as an empty string to skip that feature entirely -
// everything else (dashboard, history, CSV export) works fine without it.

#define GOOGLE_SCRIPT_URL "https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec"
